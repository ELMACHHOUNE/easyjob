# ============================================================
# EasyJob — Environment variables
# Copy this file to `.env` and fill in your own values.
# ============================================================

# --- Serveur ---
# Port de l'API Express (utilisé par le frontend via le proxy Vite)
PORT=5000

# URL du frontend (séparée par des virgules si plusieurs origines CORS)
FRONTEND_URL=http://localhost:5173

# --- Base de données ---
# URI MongoDB (connectivité locale ou MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/easyjob

# --- Authentification JWT ---
# Remplacez par des secrets forts et uniques en production
JWT_SECRET=change_me_long_random_secret
JWT_REFRESH_SECRET=change_me_another_long_random_secret

# --- Envoi d'emails (SMTP) ---
# Défaut: Gmail. Adaptez HOST/PORT pour votre fournisseur (voir https://nodemailer.com/smtp/)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Adresse d'expéditeur affichée (par défaut: EMAIL_USER)
EMAIL_FROM=EasyJob <your_email@gmail.com>

# --- Frontend (Vite) ---
# URL du proxy API. Laissez vide pour utiliser le proxy Vite en dev (/api)
# En production, définissez l'URL absolue de votre API
# VITE_API_URL=

# URL du serveur Socket.IO. Laissez vide pour utiliser le même hôte que le frontend en dev
# VITE_SOCKET_URL=