# ============================================================
# EasyJob — Frontend / Client (.env.example)
# Copier ce fichier vers `.env` (racine du projet) et remplir vos valeurs.
# Il ne sert qu'au CLIENT (Vite). Seules les variables préfixées
# VITE_ sont exposées publiquement au navigateur.
#
# Les variables du serveur (PORT, MONGODB_URI, JWT_*, EMAIL_*, ...)
# vivent dans backend/.env — voir backend/.env.example.
# ============================================================

# URL de base de l'API (CÔTÉ SERVEUR).
# En développement, pointez vers le backend local pour que les requêtes
# soient protégées par la CORS origin (backend/.env -> FRONTEND_URL doit
# autoriser l'origine du frontend). En production, mettre l'URL absolue.
VITE_API_URL=http://localhost:5000/api

# URL du serveur Socket.IO (CÔTÉ SERVEUR).
# Même origine que VITE_API_URL pour passer la CORS.
VITE_SOCKET_URL=http://localhost:5000

# --- Options du dev server Vite (optionnel) ---
# VITE_PORT=5173
# VITE_HOST=localhost
# VITE_OPEN=true
# VITE_PREVIEW_PORT=4173
# Cible du proxy /api et /socket.io (par défaut: localhost:5000).
# VITE_API_PROXY_TARGET=http://localhost:5000