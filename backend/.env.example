# ============================================================
# EasyJob — Backend / API (.env.example)
# Copier ce fichier vers `backend/.env` et remplir vos valeurs.
# Il ne sert qu'au SERVEUR (Express / Socket.IO / MongoDB / JWT / SMTP).
# ============================================================

# --- Serveur ---
# Port de l'API Express (utilisé par le frontend via le proxy Vite)
PORT=5000

# URL(s) du frontend autorisées par CORS (séparées par des virgules si plusieurs).
# Utilisées aussi pour les liens de reset de mot de passe.
# Ex: FRONTEND_URL=http://localhost:5173,https://monapp.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Base de données ---
# URI MongoDB (connectivité locale ou MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/easyjob

# --- Authentification JWT ---
# Remplacez par des secrets forts et uniques en production
JWT_SECRET=change_me_long_random_secret
JWT_REFRESH_SECRET=change_me_another_long_random_secret

# --- Envoi d'emails (SMTP / nodemailer) ---
# SMTP obligatoire pour l'envoi réel d'emails (vérification, reset de mot de passe, notifications).
# Sans EMAIL_USER/EMAIL_PASS valides, aucun email n'est envoyé (log console à la place).
# Ports courants: 587 (STARTTLS), 465 (SSL/TLS direct). secure est activé automatiquement sur 465.
# Gmail: utilisez un "mot de passe d'application" (pas votre mot de passe normal).
# Voir https://nodemailer.com/smtp/
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Adresse d'expéditeur affichée (par défaut: EMAIL_USER)
EMAIL_FROM=EasyJob <your_email@gmail.com>